{
  "name": "hopsig-site",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:studio": "pnpm --filter studio dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "check:content": "node --no-warnings scripts/content_corpus.mjs && node scripts/seed.mjs && python scripts/check_bundle.py",
    "shot": "node scripts/shot.mjs",
    "check:mobile": "node scripts/check_mobile.mjs",
    "placeholders": "node --no-warnings scripts/content_corpus.mjs && node scripts/placeholders.mjs",
    "anim:static": "node scripts/anim_static.mjs",
    "anim:test": "node scripts/anim_test.mjs",
    "anim:flows": "node scripts/anim_flows.mjs",
    "anim:audit": "node scripts/anim_audit.mjs"
  },
  "devDependencies": {
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.0",
    "pngjs": "^7.0.0"
  }
}
