# Phase 4 wires these up. Copy to .env.local for local development.
NEXT_PUBLIC_SANITY_PROJECT_ID=e1ib49ry
NEXT_PUBLIC_SANITY_DATASET=development
NEXT_PUBLIC_SANITY_STUDIO_URL=https://hopsig.sanity.studio
# Viewer token (drafts / Presentation preview). Never commit.
SANITY_API_READ_TOKEN=
# Shared secret for the Sanity publish webhook -> /api/revalidate.
SANITY_REVALIDATE_SECRET=
# Analytics (loaded only after consent). Values live in Vercel project settings and .env.local, never in the code.
# GA4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# PostHog project API key (phc_...) and its ingestion host (US cloud: https://us.i.posthog.com)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
# Brief emails through Resend (server-only; never NEXT_PUBLIC). The recipient is Site settings -> Brief recipient.
RESEND_API_KEY=
# A sender on the domain verified in Resend, e.g. Hopsig website <website@hopsig.com>
CONTACT_FROM=
